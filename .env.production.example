# =====================================================================
# VIDESGRENIER.BE — Modèle de .env pour OVH mutualisé
#
# 1. Copiez ce fichier en « .env » à la racine du projet sur OVH.
# 2. Remplacez chaque <...> par la vraie valeur.
# 3. Ne commitez jamais le .env réel (mots de passe, clé d'appli) —
#    seul ce modèle doit rester dans le dépôt.
# =====================================================================

APP_NAME=Videsgrenier.be
APP_ENV=production
# Générée en local avec : php artisan key:generate --show
# Collez ici la valeur affichée, ne la régénérez jamais en production
# (ça invaliderait les sessions et le chiffrement existants).
APP_KEY=base64:tFTY0ahPb8ys56+HJWPlDgQ7eDc/qyBlGTUDuiHtjn4=
# En production, les erreurs ne doivent jamais s'afficher au visiteur.
APP_DEBUG=false
APP_URL=https://www.videsgrenier.be

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Europe/Brussels

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Base de données -------------------------------------------------
# Visible dans l'espace client OVH > Hébergements > Bases de données.
# DB_HOST se termine toujours par « .mysql.db » chez OVH — jamais 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=<votre-base>.mysql.db
DB_PORT=3306
DB_DATABASE=<nom-de-la-base-ovh>
DB_USERNAME=<utilisateur-ovh>
DB_PASSWORD=<mot-de-passe-ovh>

# --- Sessions & cache --------------------------------------------------
# Le mutualisé n'offre pas Redis : "file" fonctionne très bien à ce trafic.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Fichiers uploadés (photos réalisations, galeries, blog) --------
FILESYSTEM_DISK=public

# --- Mail transactionnel (spec §2 : Postmark ou Brevo) ---------------
# Ne jamais utiliser MAIL_MAILER=log en production : les devis et
# accusés de réception ne partiraient jamais réellement.
MAIL_MAILER=smtp
MAIL_HOST=<smtp.postmarkapp.com-ou-smtp-relay.brevo.com>
MAIL_PORT=587
MAIL_USERNAME=<identifiant-smtp>
MAIL_PASSWORD=<mot-de-passe-ou-token-smtp>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=devis@videsgrenier.be
MAIL_FROM_NAME="${APP_NAME}"
